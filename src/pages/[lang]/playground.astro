---
import { type Locale, locales, t } from '../../i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../../layouts/Base.astro';
import PlaygroundCanvas from '../../components/PlaygroundCanvas.astro';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const homeHref = getRelativeLocaleUrl(lang, '');

const meta = {
  ja: { title: 'Playground | 相曽 結', description: '相曽 結の実験場' },
  en: { title: 'Playground | AISO, Hitoshi', description: 'Playground of AISO, Hitoshi' },
} as const;
---

<Base locale={lang} title={meta[lang].title} description={meta[lang].description}>
  <main class="fixed inset-0 overflow-hidden">
    <PlaygroundCanvas />
    <a
      href={homeHref}
      class="fixed top-[1.5rem] left-[clamp(1.25rem,5vw,2rem)] z-10 text-[0.95rem] text-fg no-underline border-b border-line pb-[0.15rem] hover:text-accent hover:border-accent"
    >
      {t(lang, 'playground_back')}
    </a>
  </main>
</Base>
