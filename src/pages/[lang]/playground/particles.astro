---
import PlaygroundBack from '../../../components/PlaygroundBack.astro';
import PlaygroundCanvas from '../../../components/PlaygroundCanvas.astro';
import { experiments } from '../../../data/experiments';
import { type Locale, locales } from '../../../i18n/ui';
import Base from '../../../layouts/Base.astro';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const experiment = experiments.find((e) => e.slug === 'particles')!;
---

<Base
  locale={lang}
  title={`${experiment.title[lang]} | Playground`}
  description={experiment.summary[lang]}
>
  <main class="fixed inset-0 overflow-hidden">
    <PlaygroundCanvas />
    <PlaygroundBack locale={lang} />
  </main>
</Base>
