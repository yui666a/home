---
import { m } from '../paraglide/messages.js';
import type { Locale } from '../i18n/utils';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const otherHref = locale === 'ja' ? '/en/' : '/';
---
<nav class="container flex justify-between items-center py-[1.5rem]">
  <a
    href={locale === 'ja' ? '/' : '/en/'}
    class="font-bold tracking-[0.12em] no-underline text-[0.95rem]"
  >AISO</a>
  <div class="flex gap-[1.5rem] items-center text-[0.85rem]">
    <a href="#about" class="no-underline text-muted">{m.nav_about({}, { locale })}</a>
    <a href="#skills" class="no-underline text-muted">{m.nav_skills({}, { locale })}</a>
    <a href="#works" class="no-underline text-muted">{m.nav_works({}, { locale })}</a>
    <a href="#links" class="no-underline text-muted">{m.nav_links({}, { locale })}</a>
    <a
      href={otherHref}
      class="border border-line px-[0.7rem] py-[0.25rem] rounded-full no-underline text-[0.8rem] tracking-[0.05em]"
    >{m.lang_switch_to({}, { locale })}</a>
  </div>
</nav>
