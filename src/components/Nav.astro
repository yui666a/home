---
import { t, otherLocale, type Locale } from '../i18n/utils';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const other = otherLocale(locale);
const otherHref = other === 'ja' ? '/' : '/en/';
---
<nav
  class="container"
  style="display:flex; justify-content:space-between; align-items:center; padding-block: var(--s-4);"
>
  <a
    href={locale === 'ja' ? '/' : '/en/'}
    style="font-weight:700; letter-spacing:0.12em; text-decoration:none; font-size:0.95rem;"
  >AISO</a>
  <div style="display:flex; gap:var(--s-4); align-items:center; font-size:0.85rem;">
    <a href="#about" style="text-decoration:none; color:var(--muted);">{t(locale, 'nav.about')}</a>
    <a href="#skills" style="text-decoration:none; color:var(--muted);">{t(locale, 'nav.skills')}</a>
    <a href="#works" style="text-decoration:none; color:var(--muted);">{t(locale, 'nav.works')}</a>
    <a href="#links" style="text-decoration:none; color:var(--muted);">{t(locale, 'nav.links')}</a>
    <a
      href={otherHref}
      style="border:1px solid var(--line); padding:0.25rem 0.7rem; border-radius:999px; text-decoration:none; font-size:0.8rem; letter-spacing:0.05em;"
    >{t(locale, 'lang.switchTo')}</a>
  </div>
</nav>
