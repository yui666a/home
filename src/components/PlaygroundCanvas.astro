---
// playground 専用の全画面 粒子ネットワーク。
// HeroBackground をベースにするが、背景前提(マスク/pointer-events-none/aria-hidden)を外し
// 全画面で主役として見せる。HeroBackground 自体には手を加えない(不可侵)。
// prefers-reduced-motion 対応は踏襲する。
---

<canvas id="playground-canvas" class="fixed inset-0 w-full h-full z-0"></canvas>

<script>
  import * as THREE from 'three';
  import { addParticleField } from '../scripts/particle-field';

  const canvas = document.getElementById('playground-canvas') as HTMLCanvasElement | null;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (canvas && !reduce) {
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(60, 1, 0.1, 100);
    camera.position.z = 14;

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    const tickParticles = addParticleField(scene);

    const pointer = { x: 0, y: 0 };
    window.addEventListener('pointermove', (e) => {
      pointer.x = (e.clientX / window.innerWidth - 0.5) * 2;
      pointer.y = (e.clientY / window.innerHeight - 0.5) * 2;
    });

    function resize() {
      const w = window.innerWidth;
      const h = window.innerHeight;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }
    resize();
    window.addEventListener('resize', resize);

    function frame() {
      tickParticles();

      // マウスにわずかに視点を傾ける
      camera.position.x += (pointer.x * 1.6 - camera.position.x) * 0.04;
      camera.position.y += (-pointer.y * 1.2 - camera.position.y) * 0.04;
      camera.lookAt(0, 0, 0);

      renderer.render(scene, camera);
      requestAnimationFrame(frame);
    }
    frame();
  }
</script>
