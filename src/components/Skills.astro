---
import { t, type Locale } from '../i18n/utils';
import { skills } from '../data/skills';
interface Props { locale: Locale; }
const { locale } = Astro.props;
---
<section id="skills" class="container reveal">
  <h2>{t(locale, 'skills.heading')}</h2>
  {skills.map((cat) => (
    <div style="margin-bottom: var(--s-5);">
      <h3 style="font-size:0.9rem; font-weight:600; color:var(--muted); margin-bottom: var(--s-3);">{locale === 'ja' ? cat.category.ja : cat.category.en}</h3>
      <ul style="list-style:none; padding:0; margin:0; display:flex; flex-wrap:wrap; gap: var(--s-2) var(--s-4);">
        {cat.items.map((item) => (
          <li style="display:flex; align-items:center; gap:0.5rem; font-size:0.95rem;">
            {item.logo && <img src={item.logo} alt={item.name} width="22" height="22" style="display:inline;" />}
            <span>{item.name}</span>
          </li>
        ))}
      </ul>
    </div>
  ))}
</section>
