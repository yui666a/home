---
import { t } from '../i18n/ui';
import type { Locale } from '../i18n/utils';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const links = [
  { label: 'GitHub', url: 'https://github.com/yui666a' },
  { label: 'Qiita', url: 'https://qiita.com/yui666a' },
  { label: 'Zenn', url: 'https://zenn.dev/yui666a' },
  { label: 'X', url: 'https://x.com/yui_ai0216' },
];
---

<section id="links" class="container reveal section-y">
  <h2>{t(locale, 'links_heading')}</h2>
  <ul class="list-none p-0 m-0 flex flex-wrap gap-[1.5rem]">
    {
      links.map((l) => (
        <li>
          <a
            href={l.url}
            target="_blank"
            rel="noopener"
            class="text-[0.95rem] no-underline border-b border-line pb-[0.15rem]"
          >
            {l.label}
          </a>
        </li>
      ))
    }
  </ul>
</section>
