---
import { t } from '../i18n/ui';
import type { Locale } from '../i18n/utils';
import SectionHeading from './SectionHeading.astro';
import { sectionNo } from '../data/sections';
import { links } from '../data/links';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<section id="links" class="container reveal section-y">
  <SectionHeading num={sectionNo.links} label={t(locale, 'links_heading')} />
  <ul class="list-none p-0 m-0 flex flex-wrap gap-[1.5rem]">
    {
      links.map((l) => (
        <li>
          <a
            href={l.url}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-[0.4rem] text-[0.95rem] no-underline border-b border-line pb-[0.15rem]"
          >
            <img src={l.logo} alt="" width="18" height="18" class="inline" />
            {l.label}
          </a>
        </li>
      ))
    }
  </ul>
</section>
