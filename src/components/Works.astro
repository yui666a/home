---
import { t, type Locale } from '../i18n/utils';
import { works } from '../data/works';
interface Props { locale: Locale; }
const { locale } = Astro.props;
---
<section id="works" class="container">
  <h2>{t(locale, 'works.heading')}</h2>
  <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(220px, 1fr)); gap: var(--s-3);">
    {works.map((w) => (
      <a
        href={w.url}
        target="_blank"
        rel="noopener"
        style="border:1px solid var(--line); border-radius:12px; padding: var(--s-4); text-decoration:none; display:block; background:#fff; transition:border-color .15s;"
      >
        <h3 style="margin:0 0 var(--s-2); font-size:1.05rem; letter-spacing:-0.01em;">{locale === 'ja' ? w.title.ja : w.title.en}</h3>
        <p class="muted" style="margin:0 0 var(--s-3); font-size:0.9rem; line-height:1.6;">{locale === 'ja' ? w.summary.ja : w.summary.en}</p>
        <div style="display:flex; flex-wrap:wrap; gap:0.4rem;">
          {w.tags.map((tag) => (
            <span style="font-size:0.72rem; color:var(--muted); border:1px solid var(--line); padding:0.15rem 0.55rem; border-radius:999px;">{tag}</span>
          ))}
        </div>
      </a>
    ))}
  </div>
</section>
