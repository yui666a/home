---
import { Image } from 'astro:assets';
import { analyzeHeroImage, heroAssetPath } from '../data/heroImages';

// src/assets/hero/ 配下の画像を自動収集する。画像を足す/減らすだけで枚数が変わる。
const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/hero/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
// glob の列挙順は環境で揺れうるため、パス名で並びを固定する
const keys = Object.keys(modules).sort();

// 明暗はビルド時に実測して決める。ファイル名で手管理すると、
// 画像を差し替えたときに判定を直し忘れて文字が読めなくなる。
const images = await Promise.all(
  keys.map(async (key) => {
    const src = modules[key].default;
    const file = key.split('/').pop() as string;
    const { tone, luma } = await analyzeHeroImage(heroAssetPath(file));
    return { src, tone, luma };
  }),
);

// 切り替え間隔(ms)。CSS アニメーションではなく JS で回すのは、
// 枚数が可変でキーフレームを静的に書けないため。
const INTERVAL = 6000;

// 各スライドのトーンをクライアントへ渡し、切り替えに合わせて文字色を反転させる
const tones = images.map((i) => i.tone).join(',');
---

{
  images.length > 0 && (
    <div class="hero-bg" aria-hidden="true" data-interval={INTERVAL} data-tones={tones}>
      {images.map((img, i) => (
        <div class:list={['hero-bg-slide', i === 0 && 'is-active']} data-tone={img.tone}>
          <Image
            src={img.src}
            alt=""
            widths={[640, 1024, 1440]}
            sizes="100vw"
            quality={55}
            loading={i === 0 ? 'eager' : 'lazy'}
            class="hero-bg-img"
          />
          {/* スクリムはスライドごとに持たせる。明暗で色が違うため、
              1 枚を共有すると切り替え時に色が飛んで見える */}
          <div class="hero-bg-scrim" />
        </div>
      ))}
    </div>
  )
}

<style>
  .hero-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    /* 背景なので選択・タップ対象にしない */
    pointer-events: none;
    user-select: none;
  }

  .hero-bg-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.6s ease-in-out;
  }
  .hero-bg-slide.is-active {
    opacity: 1;
  }

  .hero-bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* 風景・モノ中心の写真を想定。全面に敷くと上下が切れるため、
       被写体が中央よりやや上に来ることが多い構図に合わせて中央固定にする */
    object-position: center;
  }

  .hero-bg-scrim {
    position: absolute;
    inset: 0;
  }

  /* 明るい写真: 背景色を薄く重ねて濃色の文字を立たせる。
     全面を厚く覆うと写真が見えなくなるため 2 層に分け、
     radial でテキストが乗る側だけを局所的に守る */
  .hero-bg-slide[data-tone='light'] .hero-bg-scrim {
    background:
      radial-gradient(
        150% 100% at 30% 60%,
        color-mix(in srgb, var(--bg) 90%, transparent) 0%,
        color-mix(in srgb, var(--bg) 78%, transparent) 35%,
        color-mix(in srgb, var(--bg) 40%, transparent) 65%,
        transparent 88%
      ),
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--bg) 34%, transparent) 0%,
        color-mix(in srgb, var(--bg) 24%, transparent) 55%,
        color-mix(in srgb, var(--bg) 74%, transparent) 100%
      );
  }

  /* 暗い写真: 白で覆うと夜景が灰色に濁るため、暗いまま沈めて白文字を乗せる。
     下端だけは背景色へ繋いで、次セクションとの段差を消す */
  .hero-bg-slide[data-tone='dark'] .hero-bg-scrim {
    background:
      radial-gradient(
        150% 100% at 30% 60%,
        rgb(0 0 0 / 0.55) 0%,
        rgb(0 0 0 / 0.4) 40%,
        rgb(0 0 0 / 0.1) 75%,
        transparent 92%
      ),
      linear-gradient(
        to bottom,
        rgb(0 0 0 / 0.15) 0%,
        rgb(0 0 0 / 0.1) 45%,
        color-mix(in srgb, var(--bg) 55%, transparent) 88%,
        color-mix(in srgb, var(--bg) 88%, transparent) 100%
      );
  }

  /* 切り替えのアニメーションは演出であって情報ではないため、
     reduce 指定時は 1 枚目で静止させる(JS 側でも回転を止める) */
  @media (prefers-reduced-motion: reduce) {
    .hero-bg-slide {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.hero-bg').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('.hero-bg-slide')];
    if (slides.length === 0) return;

    // 文字色の反転は Hero 全体に効かせる必要があるため、ラッパーへ状態を上げる
    const host = root.parentElement;
    const applyTone = (i: number) => {
      host?.setAttribute('data-hero-tone', slides[i].dataset.tone ?? 'light');
    };
    applyTone(0);

    if (slides.length < 2) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) return;

    const interval = Number(root.dataset.interval ?? '6000');
    let index = 0;
    let timer: number | undefined;

    function step() {
      slides[index].classList.remove('is-active');
      index = (index + 1) % slides.length;
      slides[index].classList.add('is-active');
      applyTone(index);
    }

    function start() {
      if (timer === undefined) timer = window.setInterval(step, interval);
    }
    function stop() {
      if (timer !== undefined) {
        window.clearInterval(timer);
        timer = undefined;
      }
    }

    // 非表示タブで回し続けても意味がないので止める
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });

    // Hero が画面外に出たら止める(下部セクション閲覧中の無駄な再描画を避ける)
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) start();
            else stop();
          }
        },
        { threshold: 0 },
      );
      io.observe(root);
    } else {
      start();
    }
  });
</script>
